# AI design/tooling MCP keys. Do not commit real keys.
# Copy this file to .env.ai.local in the project root when Claude/Codex MCP tools need auth.

# Google Stitch MCP proxy
STITCH_API_KEY=

# 21st.dev Magic MCP
TWENTYFIRST_API_KEY=

# Google Search Console + GA4 (SEO health MCP) — see docs/seo-monitoring.md
# Absolute path to the service-account JSON key. Store the key OUTSIDE the repo.
GSC_GA_SA_KEYFILE=
# Search Console property. Domain property uses the sc-domain: form.
GSC_SITE_URL=sc-domain:lexylamparelli.cv
# NUMERIC GA4 property id from GA4 Admin → Property Settings (NOT the G- measurement id).
GA4_PROPERTY_ID=
